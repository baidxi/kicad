                    </object>
                  </object>
                </object>
                <!-- fgDelta (3-col flex grid) -->
                <object class="sizeritem" expanded="true">
                  <property name="border">5</property>
                  <property name="flag">wxEXPAND|wxALL</property>
                  <property name="proportion">0</property>
